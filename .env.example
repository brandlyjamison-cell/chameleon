# Copy to .env and fill. Never commit .env (INV-SEC-08).

# GitHub — repo administration only, scope: repo
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=chameleon

# Cloudflare — account token, scoped per service, never a global key
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare Email Service (stage 3+): verification and receipts
CLOUDFLARE_EMAIL_API_TOKEN=
MAIL_FROM=

# R2 S3 credentials (stage 6+)
S3_API_endpoint=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Neon (provisioning only)
NEON_API_KEY=
NEON_PROJECT_ID=

# Control host (stage 3+); the roster bits deploy.mjs reads
DOMAIN=
Server_IP=
DEPLOY_USER=

# Postgres (stage 2+); one DSN per role and environment
DATABASE_URL_APP_RW=
DATABASE_URL_MIGRATOR=
DATABASE_URL_EDGE_RO=
DATABASE_URL_ADMIN=

# Better Auth (stage 3+)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Jobs (stage 4+); systemd timer posts to /api/jobs/domains with this token
JOBS_TOKEN=
CLOUDFLARE_ZONE_ID=

# NowPayments (stage 9+)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Observability (stage 10+)
SENTRY_DSN_EDGE=
AXIOM_TOKEN=
