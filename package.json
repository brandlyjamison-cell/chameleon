{
  "name": "chameleon",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "gate:fast": "node scripts/gate.mjs --fast",
    "gate": "node scripts/gate.mjs --full",
    "ci": "node scripts/gate.mjs --full",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:no-client-resolution": "node scripts/check-no-client-resolution.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:commit": "commitlint --edit",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "dotenv-cli": "^11.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "globals": "^17.14.0",
    "pg": "^8.23.1",
    "playwright": "^1.65.1",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "type": "module"
}
